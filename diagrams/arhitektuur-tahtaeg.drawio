        </mxCell>
        <mxCell id="release-scope" value="Esimesse versiooni: US-01–US-05 (P1).&lt;br&gt;Hiljem: US-06 (P2), US-07 ja US-08 (P3).&lt;br&gt;Alguses poole võrra lühem tähtaeg: 3 nädalat × 10 h = 30 h.&lt;br&gt;Lood 20 h + seadistus 2 h + demo 1 h + puhver 3 h + proovikasutus ja kasutuselevõtt 4 h.&lt;br&gt;Uuenda tahvlil prioriteedid, kaartide pealkirjad ja kirjeldused." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;">
          <mxGeometry as="geometry" x="80" y="760" width="1000" height="180" />
        </mxCell>
